# GEMINI_API_KEY: Chave de API do Google Gemini AI (obtenha em https://aistudio.google.com/app/apikey)
# Na Vercel, adicione esta variável em: Project Settings -> Environment Variables
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"

# JWT_SECRET: Chave secreta para tokens de autenticação
JWT_SECRET="edutask-super-secret-jwt-key-2026"

# APP_URL: URL do aplicativo (na Vercel, a Vercel preenche VERCEL_URL automaticamente)
APP_URL="https://seu-app.vercel.app"
